{
  "name": "trakya-kizani-server",
  "version": "0.1.0",
  "private": true,
  "description": "Trakya Kızanı backend - OpenAI proxy servisi",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "persona-test": "tsx persona-tests/run.ts",
    "persona-test:dry-run": "tsx persona-tests/run.ts --dry-run",
    "persona-test:typecheck": "tsc -p tsconfig.persona-tests.json"
  },
  "dependencies": {
    "@google/genai": "^2.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
