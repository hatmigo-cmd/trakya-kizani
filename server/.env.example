# Gemini API anahtarınızı buraya yazıp dosyayı ".env" olarak kaydedin.
# ".env" dosyası .gitignore içinde olduğu için asla repoya commitlenmez.
GEMINI_API_KEY=AIza...

# Hangi Gemini modelinin kullanılacağı (maliyet/performans dengesi için
# küçük bir model önerilir; ihtiyaç halinde değiştirin)
GEMINI_MODEL=gemini-2.5-flash

# Sunucunun dinleyeceği port
PORT=3000

# OPSİYONEL: sadece server/persona-tests --judge aşaması için kullanılır
# (ana sohbet akışı artık Gemini kullanır, bu ikisi gerekmez).
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
